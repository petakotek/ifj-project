import "ifj25" for Ifj
class Program {
    static inc(x) { x + 1 }
    static main() {
        if (false || true) {
            Ifj.write("true_or")
        }
        if (false || false) {
            Ifj.write("should_not_print")
        } else {
            Ifj.write("false_or")
        }
    }
}
