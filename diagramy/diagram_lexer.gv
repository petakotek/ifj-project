digraph LexerStateMachine {
    // ===================== GLOBÁLNÍ NASTAVENÍ =====================
    rankdir=LR; 
    size="11,8"; 
    splines=true; 
    nodesep=0.2;   
    ranksep=0.4;   
    
    node [
        fontname="Consolas", 
        fontsize=11, 
        style="filled,rounded", 
        shape=rect,       
        penwidth=1.2,     
        color="#807272"
    ];
    edge [fontname="Consolas", fontsize=10, color="#333333", arrowsize=0.8];

    // ===================== DEFINICE STAVŮ =====================
    
    // 1. Startovní stav
    node [fillcolor="#FFF59D", peripheries=2];
    SLX [label="START_LEX"];

    // 2. Terminální stavy (červené)
    node [fillcolor="#ca8d8d", peripheries=1];
    END_Q1; HEXA_ZNAK; DOUBLE_Q; END_Q2;
    
    // 3. Čísla (Modré)
    node [fillcolor="#E5F0FF", peripheries=2, penwidth=1.2];
    ZERO; NUMBER; HEXA_NUM; FLOAT_N; DIGIT_EXP; FLOAT_EXP;

    // 4. Řetězce (Zelené)
    node [fillcolor="#D8FFD8"];
    STRING; STRING_BLOCK;

    // 5. Operátory (Fialové)
    node [fillcolor="#EEDBFF"];
    PLUS; MINUS; STAR; COMMA; DOT; DOUBLE_DOT; TRIPLE_DOT; COLON; QUESTION_MARK;
    ASSIGN; EQ; LT; LTE; GT; GTE;
    AND_HALF; AND; OR_HALF; OR; NEGACE; NOT;
    BLOCK_START; BLOCK_END; PAR_LEFT; PAR_RIGHT;
    UNDERSCORE; 
    SLASH;

    // 6. Identifikátory (Oranžové)
    node [fillcolor="#f7a996"];
    ID; GLOBAL_ID;

    // 7. Komentáře (Žluté světlé)
    node [fillcolor="#FFF4CC"];
    LINE_COMMENT; BLOCK_COMMENT;


    // ===================== PŘECHODY =====================

    start_point [shape=point, width=0, style=invis];
    start_point -> SLX;

    // OPRAVA: Použití platných portů nw -> ne (horní smyčka)
    SLX:jw -> SLX:je [label=" whitespace                   "];


    // ----- IDENTIFIKÁTORY -----
    SLX -> ID [label=" isalpha() "];
    SLX -> UNDERSCORE [label=" _ "];
    
    ID -> ID [label=" alnum | _ "];
    UNDERSCORE -> GLOBAL_ID [label=" _ "];
    UNDERSCORE -> ID [label=" alnum "];


    // ----- ČÍSLA -----
    SLX -> ZERO [label=" 0 "];
    SLX -> NUMBER [label=" digit "];

    ZERO -> HEXA_NUM [label=" x "];
    ZERO -> FLOAT_N [label=" . "];
    ZERO -> DIGIT_EXP [label=" e/E "];

    NUMBER -> NUMBER [label=" digit "];
    NUMBER -> FLOAT_N [label=" . "];
    NUMBER -> DIGIT_EXP [label=" e/E "];

    HEXA_NUM -> HEXA_NUM [label=" hex "];
    FLOAT_N -> FLOAT_N [label=" digit "];
    FLOAT_N -> FLOAT_EXP [label=" e/E "];
    DIGIT_EXP -> DIGIT_EXP [label=" digit "];
    FLOAT_EXP -> FLOAT_EXP [label=" digit "];


    // ----- ŘETĚZCE -----
    SLX -> STRING [label=" ' \" ' "]; 
    
    STRING -> STRING [label=" c > 31 "];
    STRING -> DOUBLE_Q [label=" \" "];
    STRING -> HEXA_ZNAK [label=" \\x "];
    HEXA_ZNAK -> STRING [label=" hexa_count == 2"];

    DOUBLE_Q -> STRING_BLOCK [label=" ' \" ' "];
    STRING_BLOCK -> END_Q1 [label=" ' \" ' "];
    END_Q1 -> END_Q2 [label=" ' \" ' "];
    END_Q1 -> STRING_BLOCK [label = "c != ' \" ' "];
    END_Q2 -> STRING_BLOCK [label = "c != ' \" ' "];


    // ----- KOMENTÁŘE -----
    SLX -> SLASH [label=" / "];
    SLASH -> LINE_COMMENT [label=" / "];
    SLASH -> BLOCK_COMMENT [label=" * "];
    
    LINE_COMMENT -> LINE_COMMENT [label = "c != \\n "];
    BLOCK_COMMENT -> BLOCK_COMMENT [label=" c != ' */'  "];
    // OPRAVA: Doplněn port 'n' před dvojtečku
    BLOCK_COMMENT:n -> SLX:n [label=" */ "];


    // ----- OPERÁTORY -----
    SLX -> PLUS [label=" + "];
    SLX -> MINUS [label=" - "];
    SLX -> STAR [label=" * "];
    SLX -> COMMA [label=" , "];
    SLX -> COLON [label=" : "];
    SLX -> QUESTION_MARK [label=" ? "];
    // OPRAVA: Odstraněno nadbytečné lomítko /
    SLX -> BLOCK_START [label=" { "];
    SLX -> BLOCK_END [label=" } "];
    SLX -> PAR_LEFT [label=" ( "];
    SLX -> PAR_RIGHT [label=" ) "];

    SLX -> DOT [ label=" . "];
    DOT -> DOUBLE_DOT [label=" . "];
    DOUBLE_DOT -> TRIPLE_DOT [label=" . "];

    SLX -> ASSIGN [label=" = "];
    ASSIGN -> EQ [label=" = "];
    
    SLX -> LT [label=" < "];
    LT -> LTE [label=" = "];
    
    SLX -> GT [label=" > "];
    GT -> GTE [label=" = "];
    
    SLX -> NEGACE [label=" ! "];
    NEGACE -> NOT [label=" = "];

    SLX -> AND_HALF [label=" & "];
    AND_HALF -> AND [label=" & "];
    
    SLX -> OR_HALF [label=" | "];
    OR_HALF -> OR [label=" | "];

    // ----- KONCE -----
    SLX -> EOF [label=" \\0 "];
}
