@startuml LexerStateMachine
title Stavový Automat - Lexikální Analýza (IFJ25)

' Barvy pro kategorie stavů
skinparam state {
    BackgroundColor<<START>> #FFE6E6
    BackgroundColor<<NUMBER>> #E6F3FF
    BackgroundColor<<STRING>> #E6FFE6
    BackgroundColor<<COMMENT>> #FFF9E6
    BackgroundColor<<OPERATOR>> #F0E6FF
    BackgroundColor<<TERMINAL>> #FFE6CC
}

' =============== INICIÁLNÍ STAV ===============
state START_LEX <<START>>

' =============== IDENTIFIKÁTORY ===============
state ID
state UNDERSCORE
state GLOBAL_ID

' =============== ČÍSLA ===============
state ZERO
state NUMBER
state HEXA_NUM
state FLOAT_NUMBER
state DIGIT_EXP
state FLOAT_EXP

' =============== ŘETĚZCE ===============
state STRING
state ZNAK_HEXA
state DOUBLE_QUO
state STRING_BLOCK
state END_QUO
state END_DOUBLE_QUO

' =============== KOMENTÁŘE ===============
state BACKSLASH
state LINE_COMMENT
state BLOCK_COMMENT

' =============== OPERÁTORY A SYMBOLY ===============
state PLUS
state MINUS
state SLASH
state START
state COMMA
state DOT
state DOUBLE_DOT
state TRIPLE_DOT
state COLON
state QUESTION_MARK

' =============== POROVNÁVÁNÍ ===============
state ASSIGN
state EQ
state LT
state LTE
state GT
state GTE

' =============== LOGICKÉ OPERÁTORY ===============
state AND_HALF
state AND
state OR_HALF
state OR
state NEGACE
state NOT

' =============== ZÁVORKY ===============
state BLOCK_START
state BLOCK_END
state PAR_LEFT
state PAR_RIGHT

' =============== KONCOVÉ STAVY ===============
state TOKEN_FOUND <<TERMINAL>>
state TOKEN_EOF <<TERMINAL>>
state ERROR_STATE <<TERMINAL>>

' ============================================================
' PŘECHODY Z START_LEX
' ============================================================
START_LEX --> ID : isalpha()
START_LEX --> UNDERSCORE : '_'
START_LEX --> ZERO : '0'
START_LEX --> NUMBER : isdigit()
START_LEX --> STRING : '"'
START_LEX --> BACKSLASH : '/'
START_LEX --> BLOCK_START : '{'
START_LEX --> BLOCK_END : '}'
START_LEX --> PAR_LEFT : '('
START_LEX --> PAR_RIGHT : ')'
START_LEX --> PLUS : '+'
START_LEX --> MINUS : '-'
START_LEX --> START : '*'
START_LEX --> ASSIGN : '='
START_LEX --> LT : '<'
START_LEX --> GT : '>'
START_LEX --> DOT : '.'
START_LEX --> COLON : ':'
START_LEX --> QUESTION_MARK : '?'
START_LEX --> AND_HALF : '&'
START_LEX --> OR_HALF : '|'
START_LEX --> NEGACE : '!'
START_LEX --> COMMA : ','
START_LEX --> TOKEN_EOF : '\0'
START_LEX -up-> START_LEX : is_blank()
START_LEX --> ERROR_STATE : ostatní

' ============================================================
' IDENTIFIKÁTORY
' ============================================================
ID --> ID : alnum() | '_'
ID --> TOKEN_FOUND : ostatní

UNDERSCORE --> GLOBAL_ID : '_'
UNDERSCORE --> ERROR_STATE : ostatní

GLOBAL_ID --> GLOBAL_ID : alnum() | '_'
GLOBAL_ID --> TOKEN_FOUND : ostatní

' ============================================================
' ČÍSLA
' ============================================================
ZERO --> HEXA_NUM : 'x'
ZERO --> FLOAT_NUMBER : '.'
ZERO --> DIGIT_EXP : 'e'|'E'
ZERO --> TOKEN_FOUND : ostatní
ZERO --> ERROR_STATE : isdigit()

NUMBER --> NUMBER : isdigit()
NUMBER --> FLOAT_NUMBER : '.'
NUMBER --> DIGIT_EXP : 'e'|'E'
NUMBER --> TOKEN_FOUND : ostatní

HEXA_NUM --> HEXA_NUM : isxdigit()
HEXA_NUM --> TOKEN_FOUND : ostatní

FLOAT_NUMBER --> FLOAT_NUMBER : isdigit()
FLOAT_NUMBER --> FLOAT_EXP : 'e'|'E'
FLOAT_NUMBER --> TOKEN_FOUND : ostatní

DIGIT_EXP --> DIGIT_EXP : isdigit()
DIGIT_EXP --> DIGIT_EXP : '+'|'-' (pokud isdigit next)
DIGIT_EXP --> TOKEN_FOUND : ostatní
DIGIT_EXP --> ERROR_STATE : špatný formát

FLOAT_EXP --> FLOAT_EXP : isdigit()
FLOAT_EXP --> FLOAT_EXP : '+'|'-' (pokud isdigit next)
FLOAT_EXP --> TOKEN_FOUND : ostatní
FLOAT_EXP --> ERROR_STATE : špatný formát

' ============================================================
' ŘETĚZCE
' ============================================================
STRING --> STRING : c > 31
STRING --> DOUBLE_QUO : '"'
STRING --> ZNAK_HEXA : '\\x'
STRING --> ERROR_STATE : '\0' | '\n'

ZNAK_HEXA --> ZNAK_HEXA : isxdigit() && hexa_count < 2
ZNAK_HEXA --> STRING : hexa_count == 2
ZNAK_HEXA --> ERROR_STATE : ostatní

DOUBLE_QUO --> STRING_BLOCK : '"'
DOUBLE_QUO --> TOKEN_FOUND : ostatní

STRING_BLOCK --> END_QUO : '"'
STRING_BLOCK --> ERROR_STATE : '\0'

END_QUO --> END_DOUBLE_QUO : '"'
END_QUO --> STRING_BLOCK : ostatní

END_DOUBLE_QUO --> TOKEN_FOUND : '"'
END_DOUBLE_QUO --> STRING_BLOCK : ostatní

' ============================================================
' KOMENTÁŘE
' ============================================================
BACKSLASH --> LINE_COMMENT : '/'
BACKSLASH --> BLOCK_COMMENT : '*'
BACKSLASH --> SLASH : ostatní

LINE_COMMENT --> TOKEN_FOUND : '\n'
LINE_COMMENT --> LINE_COMMENT : ostatní

BLOCK_COMMENT --> BLOCK_COMMENT : '/*' (nested)
BLOCK_COMMENT --> START_LEX : '*/'
BLOCK_COMMENT --> ERROR_STATE : EOF

' ============================================================
' OPERÁTORY A SYMBOLY
' ============================================================
ASSIGN --> EQ : '='
ASSIGN --> TOKEN_FOUND : ostatní

EQ --> TOKEN_FOUND

LT --> LTE : '='
LT --> TOKEN_FOUND : ostatní

LTE --> TOKEN_FOUND

GT --> GTE : '='
GT --> TOKEN_FOUND : ostatní

GTE --> TOKEN_FOUND

DOT --> DOUBLE_DOT : '.'
DOT --> TOKEN_FOUND : ostatní

DOUBLE_DOT --> TRIPLE_DOT : '.'
DOUBLE_DOT --> TOKEN_FOUND : ostatní

TRIPLE_DOT --> TOKEN_FOUND

' ============================================================
' LOGICKÉ OPERÁTORY
' ============================================================
AND_HALF --> AND : '&'
AND_HALF --> ERROR_STATE : ostatní

AND --> TOKEN_FOUND

OR_HALF --> OR : '|'
OR_HALF --> ERROR_STATE : ostatní

OR --> TOKEN_FOUND

NEGACE --> NOT : '='
NEGACE --> TOKEN_FOUND : ostatní

NOT --> TOKEN_FOUND

' ============================================================
' JEDNODUCHÉ SYMBOLY
' ============================================================
PLUS --> TOKEN_FOUND
MINUS --> TOKEN_FOUND
SLASH --> TOKEN_FOUND
START --> TOKEN_FOUND
COMMA --> TOKEN_FOUND
COLON --> TOKEN_FOUND
QUESTION_MARK --> TOKEN_FOUND

BLOCK_START --> TOKEN_FOUND
BLOCK_END --> TOKEN_FOUND
PAR_LEFT --> TOKEN_FOUND
PAR_RIGHT --> TOKEN_FOUND

@enduml
