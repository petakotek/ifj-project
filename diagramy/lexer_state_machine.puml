@startuml LexerStateMachine
title **Stavový Automat – Lexikální Analýza (IFJ25)**

' ===== Optimalizace pro kompaktnost =====
skinparam minSpace 15  ' Zmenší mezery mezi prvky
skinparam padding 5    ' Zmenší vnitřní výplň stavů
skinparam state {
    RoundCorner 50 
    BorderStyle double
    BorderColor #222222
    StartColor #6E93D6
    EndColor #6E93D6
    FontSize 11
    FontName Consolas

}
skinparam state {
    BackgroundColor transparent
    BorderColor #000000
}
skinparam ArrowColor #333
skinparam ArrowThickness 1.2

' Nastavení Graphvizu pro hustší rozložení
skinparam graphviz {
    Nodesep 0.1  ' Zmenšit horizontální mezeru
    Ranksep 0.3  ' Zmenšit vertikální mezeru
}
' =======================================

' ----- Barvy stavů podle kategorií -----
skinparam state {
    BackgroundColor<<COMMENT>>     #FFF4CC

}
skinparam state<<NUMBER>> {
    BorderThickness 3
    BackgroundColor  #E5F0FF
}
skinparam state<<STRING>> {
    BorderThickness 3
    BackgroundColor  #D8FFD8
}
skinparam state<<OPERATOR>> {
    BorderThickness 3
    BackgroundColor  #EEDBFF
}
skinparam state<<IDENTIFIER>> {
    BorderThickness 3
    BackgroundColor  #f7a996ff
}
skinparam state<<INVISIBLE>>{
    BackgroundColor #FFFFFF
    BorderColor #FFFFFF
    FontColor #FFFFFF 
    Shadowing false   
}

' (Legendy zůstaly beze změny, aby nezabíraly prostor rozložením)

' ===================== STAVY A SESKUPENÍ =====================

' ********** INICIALIZAČNÍ STAVY **********
    state SLX {
        whitespace : ignore
    }
    state BEGIN <<INVISIBLE>>
    
    BEGIN --> SLX


' ********** IDENTIFIKÁTORY **********
state Identifiers {
    state ID <<IDENTIFIER>>
    state UNDERSCORE <<OPERATOR>>
    state GID <<IDENTIFIER>> 
    SLX --> ID : isalpha()
    SLX --> UNDERSCORE : "_"
    ID --> ID : alnum() | "_"
    UNDERSCORE --> GID : "_"
    UNDERSCORE --> ID : alnum()
}

' ********** ČÍSLA **********
state Numbers {
    state ZERO <<NUMBER>>
    state NUMBER <<NUMBER>> 
    state HEXA_N <<NUMBER>>
    state FLOAT_N <<NUMBER>>
    state DECIMAL_E <<NUMBER>>
    state FLOAT_E <<NUMBER>> 

    SLX --> ZERO : "0"
    SLX --> NUMBER : digit
    
    ZERO --> HEXA_N : "x"
    ZERO --> FLOAT_N : "."
    ZERO --> DECIMAL_E : "e/E"

    NUMBER --> NUMBER : digit
    NUMBER --> FLOAT_N : "."
    NUMBER --> DECIMAL_E : "e/E"

    HEXA_N --> HEXA_N : hex digit
    FLOAT_N --> FLOAT_N : digit
    FLOAT_N --> FLOAT_E : "e/E"
    DECIMAL_E --> DECIMAL_E : digit
    FLOAT_E --> FLOAT_E : digit
}

' ********** ŘETĚZCE **********
state Strings {
    state STRING <<STRING>>
    state HEXA_Z <<STRING>> 
    state DOUBLE_Q 
    state STRING_B <<STRING>>
    state END_Q1 
    state END_Q2

    SLX --> STRING : ' " '
    STRING --> STRING : C > 31
    STRING --> DOUBLE_Q : "
    STRING --> HEXA_Z : "\\x"
    HEXA_Z --> STRING : valid hex escape

    DOUBLE_Q --> STRING_B : ' " '
    STRING_B --> END_Q1 : ' " '
    END_Q1 --> END_Q2 : ' " '
    END_Q1 --> STRING_B
    END_Q2 --> STRING_B
}

' ********** KOMENTÁŘE **********
state Comments {
    state SLASH <<OPERATOR>>
    state LINE_C <<COMMENT>> 
    state BLOCK_C <<COMMENT>> 

    SLX --> SLASH : "/"
    SLASH --> LINE_C : "/"
    SLASH --> BLOCK_C :  "*"
}

' ********** OPERÁTORY **********
state Operators {
    state P <<OPERATOR>> 
    state M <<OPERATOR>>
    state MU <<OPERATOR>>
    state C <<OPERATOR>> 
    state D <<OPERATOR>> 
    state DD <<OPERATOR>>
    state TD <<OPERATOR>>
    state CO <<OPERATOR>> 
    state QM <<OPERATOR>> 

    state ASS <<OPERATOR>> 
    state EQO <<OPERATOR>> 
    state LT <<OPERATOR>> 
    state LTE <<OPERATOR>>
    state GT <<OPERATOR>> 
    state GTE <<OPERATOR>>

    state AH <<OPERATOR>> 
    state A <<OPERATOR>>
    state OH <<OPERATOR>> 
    state O <<OPERATOR>>
    state NG <<OPERATOR>> 
    state NT <<OPERATOR>> 

    state BS <<OPERATOR>> 
    state BE <<OPERATOR>>
    state PL <<OPERATOR>>
    state PR <<OPERATOR>>

    ' Všechny jednopísmenné operátory a symboly od SLX
    SLX --> P : "+"
    SLX --> M : "-"
    SLX --> MU : "*"
    SLX --> C : ","
    SLX --> CO : ":"
    SLX --> QM : "?"
    SLX --> BS : "{"
    SLX --> BE : "}"
    SLX --> PL : "("
    SLX --> PR : ")"
    
    ' Dvouznakoví a tečky
    SLX --> D : "."
    D --> DD : "."
    DD --> TD : "."
    
    ' Porovnávací operátory
    SLX --> ASS : "="
    ASS --> EQO : "="
    SLX --> LT : "<"
    LT --> LTE : "="
    SLX --> GT : ">"
    GT --> GTE : "="
    SLX --> NG : "!"
    NG --> NT : "="
    
    ' Logické operátory
    SLX --> AH : "&"
    AH --> A : "&"
    SLX --> OH : "|"
    OH --> O : "|"
}

' ********** TERMINÁLNÍ STAVY **********
state EOF

' ============================================================
' Spoje ze SLX, které nevedou do subgrafů

SLX --> EOF : "\0"

' Spoje do TF (Terminální stav)


' Spoje z komentářů
LINE_C --> LINE_C
BLOCK_C --> BLOCK_C : uvnitř
BLOCK_C --> SLX : "*/"

' Spoje z operátorů


@enduml