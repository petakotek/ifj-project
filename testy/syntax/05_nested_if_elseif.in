import "ifj25" for Ifj
class Program {
    static main() {
        var x = 5
        var y = 10
        if (x < 0) {
            x = -1
            Ifj.write(x)
        } else if (x > 4) {
            x = x + 1
            Ifj.write(x)
        } else {
            x = x + 2
            Ifj.write(x)
        }
    }
}
