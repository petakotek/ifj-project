import "ifj25" for Ifj
class Program {
// Vestavěné funkce
    static main() {
        Ifj.read_num() // aaa
        Ifj.read_str() //asda
        Ifj.write("a") //dsadada
        Ifj.floor(5.2)          //dsas d
        Ifj.str("a") //adsadsa
        Ifj.length("String") // asdasd
        Ifj.substring("String", 1, 1) // sadasd
        Ifj.strcmp("String", "String") ///asdasdasdad
        Ifj.ord("String", 1) /*aaa*/ // asdasdqwqdas
        Ifj.chr(32) //asdada /*asaa*/
    }
}